    "tasks": [
        {
            "label": "gfBuild",
            "type": "shell",
            "command": "echo \"${workspaceFolder}\" && echo ${MSYSTEM} && cd \"${workspaceFolder}/build\" && cmake -G Ninja .. && ninja -j8",
